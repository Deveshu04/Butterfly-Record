  "dependencies": {
    "@butterfly-record/core": "workspace:*",
    "@butterfly-record/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.5",
    "@wxt-dev/module-svelte": "^2.0.5",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "typescript": "^6.0.3",
    "wxt": "^0.21.3"
  }
}
