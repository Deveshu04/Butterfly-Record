{
  "name": "@butterfly-record/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Butterfly Record — the Chrome extension.",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
